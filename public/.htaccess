# Badass Rentals - Apache configuratie
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS en zonder www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://badassrentals.nl/$1 [R=301,L]

# Trailing slash toevoegen aan mappen
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ---- Oude WordPress-URL's -> nieuwe pagina's (301) ----
# QR-huurovereenkomsten: korte variant -> echte adres onder /algemene-voorwaarden/ (zoals WordPress deed)
RewriteRule ^(verhuur-e-chopper-nummer-[0-9]+-met-kenteken-[a-z0-9-]+|verhuur-fatbikes-algemene-voorwaarden)/?$ /algemene-voorwaarden/$1/ [R=301,L,NC]
# Oude Yoast-sitemaps -> nieuwe sitemap
RewriteRule ^(sitemap_index|post-sitemap|page-sitemap|blocks-sitemap|category-sitemap|author-sitemap|wp-sitemap)[0-9]*\.xml$ /sitemap.xml [R=301,L,NC]
# Subpagina's van de oude site
RewriteRule ^samenwerking/(alle-voordelen-op-een-rij|samenwerkende-partijen)/?$ /samenwerking/ [R=301,L,NC]
RewriteRule ^leaderboard/.*$ / [R=301,L,NC]
RewriteRule ^virtual-reality-escape-games/.*$ /arrangementen/ [R=301,L,NC]
RewriteRule ^blocks/.*$ / [R=301,L,NC]
RewriteRule ^(tag|product|product-category)/.*$ / [R=301,L,NC]
# Homepage-varianten en verdwenen landingspagina's
RewriteRule ^(echopper-verhuur-giethoorn|badassrentals-homepagina|begin-je-badass-ride-in-giethoorn|begin-je-badass-ride-in-blokzijl|begin-je-badass-ride-in-emmeloord|echopper-rental-cast-horn|bakfiets-huren-in-giethoorn-3|media|badass-chopper-game|leaderboard)/?$ / [R=301,L,NC]
# E-chopper-varianten
RewriteRule ^(e-bike-huren-giethoorn|electrische-scooter-giethoorn|e-chopper-huren-overijssel|e-chopper-weerribben|e-chopper-drenthe|e-chopper-huren-in-blokzijl|prijzen)/?$ /e-chopper-huren-giethoorn/ [R=301,L,NC]
# Teamuitjes
RewriteRule ^(bedrijfsuitje-meppel)/?$ /teamuitje-met-echopper/ [R=301,L,NC]
# Arrangementen
RewriteRule ^(e-chopper-arrangement-weeribben-wieden|ons-badass-vaderdag-arrangement)/?$ /arrangementen/ [R=301,L,NC]
# Engelse pagina's en overige
RewriteRule ^frequently-asked-questions/?$ /veelgestelde-vragen/ [R=301,L,NC]
RewriteRule ^terms-and-conditions/?$ /algemene-voorwaarden/ [R=301,L,NC]
RewriteRule ^get-in-touch/?$ /kom-in-contact/ [R=301,L,NC]
RewriteRule ^(samenwerkende-partijen|alle-voordelen-op-een-rij)/?$ /samenwerking/ [R=301,L,NC]
# VR en escape (VR wordt niet meer aangeboden) -> arrangementen met City Escape en Detective Game
RewriteRule ^(red-flu-escape-koffer|la-casa-de-dinero-vr-escape-experience|virtual-reality-escape-games)/?$ /arrangementen/ [R=301,L,NC]
# Interactieve wandelingen (niet meer op deze site)
RewriteRule ^(interactieve-wandeling-door-meppel|interactieve-wandeling-meppel|interactieve-wandeling-door-steenwijk|interactieve-wandeling-steenwijk)/?$ / [R=301,L,NC]
# Oude blogberichten die niet meer actueel zijn
RewriteRule ^(het-beste-corona-proof-uitje-in-de-regio)/?$ /nieuws/ [R=301,L,NC]
# Cadeaubonnen worden niet meer verkocht
RewriteRule ^geef-een-badass-cadeaubon/?$ /arrangementen/ [R=301,L,NC]
RewriteRule ^(feed|comments/feed|category/.*|author/.*)/?$ /nieuws/ [R=301,L,NC]
# Voorwaarden-PDF's
RewriteRule ^wp-content/uploads/badass-rentals-algemene-voorwaarden-v1\.2-NL\.pdf$ /assets/docs/badass-rentals-algemene-voorwaarden-v1.2-NL.pdf [R=301,L,NC]
RewriteRule ^wp-content/uploads/badass-rentals-beneral-terms-v1\.1-English\.pdf$ /assets/docs/badass-rentals-general-terms-v1.1-EN.pdf [R=301,L,NC]
# WordPress-restanten blokkeren
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin/.*)$ - [G,L,NC]
</IfModule>

# Beveiliging
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
<FilesMatch "\.(csv|py|md|log)$">
  Require all denied
</FilesMatch>

# Compressie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest
